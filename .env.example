# Supabase -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Settings -> API -> JWT Settings -> JWT Secret
# Solo servidor. Firma la sesion que se emite al validar el PIN, y es lo que
# hace que la llave anon (visible en el navegador) no sirva por si sola.
SUPABASE_JWT_SECRET=

# PIN compartido para entrar a la app
APP_PIN=
